{
  "name": "@desirecore-agent/video-editing",
  "version": "0.1.2",
  "description": "视频剪辑 — DesireCore managed FableCut editor, compositor and MCP tools.",
  "main": "server.js",
  "bin": {
    "fablecut": "cli.js"
  },
  "files": [
    "*.js",
    "index.html",
    "style.css",
    "favicon.svg",
    "icons/",
    "encoding-profiles.json",
    "manifest.json",
    "AGENTS.md",
    "NOTICE.md",
    "docs/editor-guide.md",
    "desirecore/*.js",
    "desirecore/*.json",
    "desirecore/RUNTIME.md",
    "desirecore/licenses/",
    "library/README.md",
    "library/elements/",
    "library/fonts/",
    "library/svg/",
    "library/sfx/README.md",
    "!desirecore/app-release.json",
    "desirecore/*.mjs",
    "desirecore-theme.css",
    "README.md",
    "README.zh-CN.md",
    "npm-shrinkwrap.json"
  ],
  "scripts": {
    "start": "node desirecore/start.js",
    "test": "node --test",
    "setup-runtime": "node desirecore/setup-runtime.js",
    "release:material": "node desirecore/release.js",
    "check:delivery": "node .github/scripts/release-check.js",
    "test:delivery": "node --test test/desirecore-delivery*.test.js",
    "test:regression": "node --test --test-concurrency=2 test/projects.test.js test/mcp-edit-ops.test.js test/desirecore-*.test.js"
  },
  "keywords": [
    "video-editor",
    "nle",
    "timeline",
    "canvas",
    "mcp",
    "claude",
    "ai-agent",
    "ffmpeg"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/desirecore-agent/video-editing.git"
  },
  "homepage": "https://github.com/desirecore-agent/video-editing",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "private": true
}
